 "meta": {
  "codebook": "METHOD.md@v2",
  "generated_at": "2026-09-04",
  "generated_by": "audit_60_taxonomy_v2.py",
  "note": "Três eixos ortogonais (presence, depth, accuracy) + stance + reuse; highlight é editorial e fica fora das estatísticas.",
  "version": "2.0"
 },
 "migration_rules": [
  {
   "id": "R1",
   "then": "presence = reference_list_only; depth = null; accuracy = null",
   "when": "role == bibliography_only (flag ghost é absorvida)"
  },
  {
   "id": "R2",
   "then": "presence = in_text; depth = role",
   "when": "role não é bibliography_only nem wrongly_interpreted"
  },
  {
   "id": "R3",
   "then": "presence = in_text; accuracy = misrepresented; depth = brief_mention com prov.depth_basis = migration_rule_R3",
   "when": "role == wrongly_interpreted"
  },
  {
   "id": "R4",
   "then": "accuracy = imprecise",
   "when": "flag == weak"
  },
  {
   "id": "R5",
   "then": "accuracy = misrepresented (conjunto R5 tem de ser igual ao conjunto R3)",
   "when": "flag == misattribution"
  },
  {
   "id": "R6",
   "then": "relation = coauthor | self",
   "when": "flag in {coautor, autocitacao}"
  },
  {
   "id": "R7",
   "then": "record_flags = [duplicate_publication]",
   "when": "flag == duplicate"
  },
  {
   "id": "R8",
   "then": "highlight = flag",
   "when": "flag in {good, best}"
  },
  {
   "id": "R9",
   "then": "descartada — 100% redundante com stance == contradictory (verificado na migração)",
   "when": "flag == critical"
  },
  {
   "id": "R0",
   "then": "accuracy = accurate para in_text não tocado por R3/R4/R5; relation = independent; record_flags = []; highlight = none; distortion = null; claims = []",
   "when": "padrão"
  }
 ],
