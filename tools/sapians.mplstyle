# VITA — superfície branca, hierarquia neutra, Inter OFL para publicação aberta.
# Figure
figure.facecolor: FFFFFF
figure.edgecolor: FFFFFF
figure.dpi: 100          # DELTA (marca: 300) — este é o DPI do PNG inline
                         # que o Jupyter embute em base64 no .ipynb. A 300 o
                         # caderno commitado incha por ordem de grandeza sem
                         # que ninguém veja diferença na tela.
savefig.dpi: 150         # DELTA (marca: não define) — o arquivo promovido
                         # para modules/NN-slug/figures/ é impresso e
                         # projetado; 150 é o mínimo que aguenta os dois.
figure.autolayout: False # DELTA (marca: True) — autolayout conflita com o
                         # tight_layout(rect=...) que SP.salvar aplica para
                         # reservar a banda do título. Com os dois ligados o
                         # título senta em cima do gráfico.

# Axes
axes.facecolor: FFFFFF
axes.edgecolor: DDDDDD
axes.linewidth: 0.8
axes.grid: True
axes.grid.which: major
axes.grid.axis: y
axes.titlesize: 11
axes.titleweight: medium
axes.titlepad: 12
axes.titlecolor: 212322
axes.labelsize: 8.5
axes.labelweight: medium
axes.labelcolor: 606060
axes.labelpad: 6
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
axes.prop_cycle: cycler('color', ['212322', '606060', '808080', 'B8B8B8', 'E5E5E5'])

# Grid
grid.color: F2F3F3
grid.linestyle: -
grid.linewidth: 0.5
grid.alpha: 0.8

# Ticks
xtick.direction: out
ytick.direction: out
xtick.color: 606060
ytick.color: 606060
xtick.labelsize: 7.5
ytick.labelsize: 7.5
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.8
ytick.major.width: 0.8

# Legend
legend.frameon: False
legend.framealpha: 0.95
legend.facecolor: FFFFFF
legend.edgecolor: DDDDDD
legend.fancybox: True
legend.fontsize: 7.5
legend.borderpad: 0.6
legend.labelspacing: 0.5

# Lines and Scatters
lines.linewidth: 1.6
lines.solid_capstyle: round
lines.markersize: 5
scatter.edgecolors: none

# Typography
font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Arial, DejaVu Sans
font.monospace: JetBrains Mono, Menlo, Courier New, DejaVu Sans Mono
text.color: 212322
